import { ComboBox, ScrollView } from "std-widgets.slint";
import { Palette, Translator, Card, Divider, ActionButton, InfoRow, PortListItem, VerdictCard } from "components.slint";

export struct PortEntry {
    name: string,
    description: string,
}

export component AppWindow inherits Window {
    title: "ESP32 Board Checker";
    icon: @image-url("../logo.png");
    // 注意：min-width/min-height 不能与 width/height 同时设置（Slint 编译错误）
    preferred-width: 940px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 640px;
    background: Palette.bg;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    in property <[PortEntry]> ports;
    in-out property <int> selected-index: 0;
    in property <string> selected-port-name: "未选择串口";
    in property <bool> busy: false;
    // 语言：0 简体中文，1 繁体中文，2 English
    in-out property <int> lang: 0;

    in property <string> status-text: "就绪，请选择一个串口后开始检测";
    in property <string> chip-text: "—";
    in property <string> revision-text: "—";
    in property <string> mac-text: "—";
    in property <string> flash-text: "—";
    in property <string> crystal-text: "—";
    in property <string> features-text: "—";
    in property <string> usb-bridge-text: "—";
    in property <string> last-check-text: "—";

    // verdict-kind: "idle" | "busy" | "ok" | "bad"
    in property <string> verdict-kind: "idle";
    in property <string> verdict-title: "未检测";
    in property <string> verdict-reason: "连接开发板后刷新串口，再点击按钮开始检测。";

    callback refresh-ports();
    callback select-port(int);
    callback detect();
    callback apply-language();

    // ---- 界面文案（随 lang 切换）----
    property <string> t-subtitle: Translator.choose(root.lang, "扫描串口 · 一键检测 · 输出芯片 / MAC / Flash 信息", "掃描串口 · 一鍵檢測 · 輸出晶片 / MAC / Flash 資訊", "Scan serial ports · One-click check · Chip / MAC / Flash info");
    property <string> t-ports-title: Translator.choose(root.lang, "串口列表", "串口列表", "Serial Ports");
    property <string> t-refresh: Translator.choose(root.lang, "刷新", "重新整理", "Refresh");
    property <string> t-empty-title: Translator.choose(root.lang, "暂无可用串口", "暫無可用串口", "No serial ports found");
    property <string> t-empty-hint: Translator.choose(root.lang, "请连接开发板 USB 线后点击刷新", "請連接開發板 USB 線後點擊重新整理", "Connect the board via USB, then click Refresh");
    property <string> t-list-hint: ports.length == 0
        ? Translator.choose(root.lang, "等待串口设备接入", "等待串口裝置接入", "Waiting for a device…")
        : Translator.choose(root.lang, "已发现串口，请选择后检测", "已發現串口，請選擇後檢測", "Ports found — select one to check");
    property <string> t-detect-button: busy
        ? Translator.choose(root.lang, "检测中…", "檢測中…", "Checking…")
        : Translator.choose(root.lang, "一键检测", "一鍵檢測", "Check");
    property <string> t-info-title: Translator.choose(root.lang, "设备信息", "裝置資訊", "Device Info");
    property <string> t-l-chip: Translator.choose(root.lang, "芯片型号", "晶片型號", "Chip");
    property <string> t-l-rev: Translator.choose(root.lang, "芯片版本", "晶片版本", "Revision");
    property <string> t-l-mac: Translator.choose(root.lang, "MAC 地址", "MAC 位址", "MAC");
    property <string> t-l-flash: Translator.choose(root.lang, "Flash 容量", "Flash 容量", "Flash");
    property <string> t-l-xtal: Translator.choose(root.lang, "晶振频率", "晶振頻率", "Crystal");
    property <string> t-l-features: Translator.choose(root.lang, "芯片特性", "晶片特性", "Features");
    property <string> t-l-bridge: Translator.choose(root.lang, "USB 桥接", "USB 橋接", "USB Bridge");
    property <string> t-l-last: Translator.choose(root.lang, "上次检测", "上次檢測", "Last Check");

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // ---------- Header ----------
        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "ESP32 Board Checker";
                    color: Palette.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: root.t-subtitle;
                    color: Palette.text-muted;
                    font-size: 12px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            ComboBox {
                width: 132px;
                model: ["简体中文", "繁体中文", "English"];
                current-index <=> root.lang;
                selected => { root.apply-language(); }
            }
        }

        // ---------- Body ----------
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            // ===== Left: serial port list =====
            Card {
                width: 350px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.t-ports-title;
                            color: Palette.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        ActionButton {
                            label: root.t-refresh;
                            button-width: root.lang == 2 ? 84px : 68px;
                            active: !root.busy;
                            clicked => { root.refresh-ports(); }
                        }
                    }

                    if root.ports.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        background: Palette.inset;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Palette.inset-border;

                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: root.t-empty-title;
                                color: Palette.text-muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.t-empty-hint;
                                color: Palette.text-dim;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.ports.length > 0 : ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 8px;

                            for entry[idx] in root.ports : PortListItem {
                                name: entry.name;
                                description: entry.description;
                                selected: idx == root.selected-index;
                                active: !root.busy;
                                clicked => { root.select-port(idx); }
                            }
                        }
                    }

                    Text {
                        text: root.t-list-hint;
                        color: Palette.text-dim;
                        font-size: 12px;
                    }
                }
            }

            // ===== Right: detection =====
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;

                            ActionButton {
                                label: root.t-detect-button;
                                primary: true;
                                button-width: 140px;
                                active: !root.busy && root.ports.length > 0;
                                clicked => { root.detect(); }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: root.selected-port-name;
                                    color: Palette.text-secondary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.status-text;
                                    color: Palette.text-muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                Card {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: root.t-info-title;
                            color: Palette.text;
                            font-size: 15px;
                            font-weight: 600;
                        }

                        // 分组：芯片信息 / 存储 / 连接 / 记录
                        InfoRow { label: root.t-l-chip; value: root.chip-text; strong: true; }
                        InfoRow { label: root.t-l-rev; value: root.revision-text; }
                        InfoRow { label: root.t-l-mac; value: root.mac-text; copyable: true; }
                        InfoRow { label: root.t-l-features; value: root.features-text; }
                        InfoRow { label: root.t-l-xtal; value: root.crystal-text; }
                        Divider {}
                        InfoRow { label: root.t-l-flash; value: root.flash-text; }
                        Divider {}
                        InfoRow { label: root.t-l-bridge; value: root.usb-bridge-text; }
                        Divider {}
                        InfoRow { label: root.t-l-last; value: root.last-check-text; }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // ===== Verdict =====
                VerdictCard {
                    kind: root.verdict-kind;
                    verdict-title: root.verdict-title;
                    verdict-reason: root.verdict-reason;
                }
            }
        }
    }
}
