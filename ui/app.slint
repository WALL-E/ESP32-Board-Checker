import { ComboBox, ScrollView } from "std-widgets.slint";

export struct PortEntry {
    name: string,
    description: string,
}

// ---------- 全局色板 ----------
global Palette {
    // 分层背景
    out property <color> bg: #0b0f14;
    out property <color> card: #161b22;
    out property <color> card-border: #232b36;
    out property <color> inset: #10151c;
    out property <color> inset-border: #1d242e;
    out property <color> selected-bg: #122033;
    out property <color> selected-border: #2d6fd6;
    // 文字
    out property <color> text: #e6edf3;
    out property <color> text-secondary: #c9d1d9;
    out property <color> text-muted: #7d8590;
    out property <color> text-dim: #5b6472;
    // 按钮与强调色
    out property <color> accent: #2563eb;
    out property <color> accent-hover: #2f7fe0;
    out property <color> accent-border: #2d6fd6;
    out property <color> button-bg: #1b222c;
    out property <color> button-hover: #232b36;
    out property <color> button-border: #30363d;
    out property <color> button-disabled: #1a2029;
    out property <color> dot: #3b82f6;
    out property <color> dot-inactive: #2b3441;
    // 判定卡：可用
    out property <color> ok-bg: #10261a;
    out property <color> ok-border: #1f6b3f;
    out property <color> ok-icon: #1f8a4c;
    out property <color> ok-title: #3fb950;
    out property <color> ok-reason: #9fcca8;
    // 判定卡：不可用 / 失败
    out property <color> bad-bg: #2a1416;
    out property <color> bad-border: #7f2d33;
    out property <color> bad-icon: #c0343c;
    out property <color> bad-title: #f85149;
    out property <color> bad-reason: #e3a3a3;
    // 判定卡：检测中 / 未检测
    out property <color> busy-bg: #101f2e;
    out property <color> busy-border: #1f4c78;
    out property <color> busy-icon: #2563eb;
    out property <color> busy-title: #58a6ff;
    out property <color> idle-icon: #262f3b;
    out property <color> idle-title: #8b949e;
}

component Card inherits Rectangle {
    background: Palette.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Palette.card-border;
    clip: true;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: true;
    in property <bool> primary: false;
    in property <length> button-width: 96px;
    callback clicked();

    width: button-width;
    height: 38px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.primary ? Palette.accent-border : Palette.button-border;
    background: !root.active ? Palette.button-disabled
        : root.primary ? (touch.has-hover ? Palette.accent-hover : Palette.accent)
        : (touch.has-hover ? Palette.button-hover : Palette.button-bg);

    Text {
        text: root.label;
        width: root.width;
        height: root.height;
        color: root.active ? (root.primary ? #ffffff : Palette.text-secondary) : Palette.text-dim;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 12px;
    alignment: start;

    Text {
        text: root.label;
        width: 88px;
        color: Palette.text-muted;
        font-size: 13px;
        vertical-alignment: center;
    }

    Text {
        text: root.value;
        color: Palette.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-stretch: 1;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

// 串口列表中的一项
component PortListItem inherits Rectangle {
    in property <string> name;
    in property <string> description;
    in property <bool> selected;
    in property <bool> active: true;
    callback clicked();

    height: 56px;
    border-radius: 10px;
    border-width: 1px;
    background: root.selected ? Palette.selected-bg : Palette.inset;
    border-color: root.selected ? Palette.selected-border : Palette.inset-border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.name;
                color: Palette.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.description;
                color: Palette.text-muted;
                font-size: 11px;
                overflow: elide;
            }
        }

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.selected ? Palette.dot : Palette.dot-inactive;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 判定卡：kind 为 "idle" | "busy" | "ok" | "bad"
component VerdictCard inherits Card {
    in property <string> kind: "idle";
    in property <string> verdict-title;
    in property <string> verdict-reason;

    property <bool> is-ok: kind == "ok";
    property <bool> is-bad: kind == "bad";
    property <bool> is-busy: kind == "busy";

    height: 104px;
    background: is-ok ? Palette.ok-bg : is-bad ? Palette.bad-bg : is-busy ? Palette.busy-bg : Palette.card;
    border-color: is-ok ? Palette.ok-border : is-bad ? Palette.bad-border : is-busy ? Palette.busy-border : Palette.card-border;

    HorizontalLayout {
        padding: 18px;
        spacing: 14px;
        cross-axis-alignment: center;

        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: root.is-ok ? Palette.ok-icon
                : root.is-bad ? Palette.bad-icon
                : root.is-busy ? Palette.busy-icon
                : Palette.idle-icon;

            Text {
                text: root.is-ok ? "✓" : root.is-bad ? "✕" : root.is-busy ? "…" : "?";
                width: parent.width;
                height: parent.height;
                color: #ffffff;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Text {
                text: root.verdict-title;
                color: root.is-ok ? Palette.ok-title
                    : root.is-bad ? Palette.bad-title
                    : root.is-busy ? Palette.busy-title
                    : Palette.idle-title;
                font-size: 17px;
                font-weight: 700;
            }
            Text {
                text: root.verdict-reason;
                color: root.is-ok ? Palette.ok-reason
                    : root.is-bad ? Palette.bad-reason
                    : Palette.idle-title;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ESP32 Board Checker";
    icon: @image-url("../logo.png");
    width: 940px;
    height: 720px;
    background: Palette.bg;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    in property <[PortEntry]> ports;
    in-out property <int> selected-index: 0;
    in property <string> selected-port-name: "未选择串口";
    in property <bool> busy: false;
    // 语言：0 简体中文，1 繁体中文，2 English
    in-out property <int> lang: 0;

    in property <string> status-text: "就绪，请选择一个串口后开始检测";
    in property <string> chip-text: "—";
    in property <string> revision-text: "—";
    in property <string> mac-text: "—";
    in property <string> flash-text: "—";
    in property <string> crystal-text: "—";
    in property <string> features-text: "—";
    in property <string> usb-bridge-text: "—";
    in property <string> last-check-text: "—";

    // verdict-kind: "idle" | "busy" | "ok" | "bad"
    in property <string> verdict-kind: "idle";
    in property <string> verdict-title: "未检测";
    in property <string> verdict-reason: "连接开发板后刷新串口，再点击按钮开始检测。";

    callback refresh-ports();
    callback select-port(int);
    callback detect();
    callback apply-language();

    // ---- 界面文案（随 lang 切换）----
    property <string> t-subtitle: lang == 2 ? "Scan serial ports · One-click check · Chip / MAC / Flash info" : lang == 1 ? "掃描串口 · 一鍵檢測 · 輸出晶片 / MAC / Flash 資訊" : "扫描串口 · 一键检测 · 输出芯片 / MAC / Flash 信息";
    property <string> t-ports-title: lang == 2 ? "Serial Ports" : "串口列表";
    property <string> t-refresh: lang == 2 ? "Refresh" : lang == 1 ? "重新整理" : "刷新";
    property <string> t-empty-title: lang == 2 ? "No serial ports found" : lang == 1 ? "暫無可用串口" : "暂无可用串口";
    property <string> t-empty-hint: lang == 2 ? "Connect the board via USB, then click Refresh" : lang == 1 ? "請連接開發板 USB 線後點擊重新整理" : "请连接开发板 USB 线后点击刷新";
    property <string> t-list-hint: ports.length == 0
        ? (lang == 2 ? "Waiting for a device…" : lang == 1 ? "等待串口裝置接入" : "等待串口设备接入")
        : (lang == 2 ? "Ports found — select one to check" : lang == 1 ? "已發現串口，請選擇後檢測" : "已发现串口，请选择后检测");
    property <string> t-detect-button: busy
        ? (lang == 2 ? "Checking…" : lang == 1 ? "檢測中…" : "检测中…")
        : (lang == 2 ? "Check" : lang == 1 ? "一鍵檢測" : "一键检测");
    property <string> t-info-title: lang == 2 ? "Device Info" : lang == 1 ? "裝置資訊" : "设备信息";
    property <string> t-l-chip: lang == 2 ? "Chip" : lang == 1 ? "晶片型號" : "芯片型号";
    property <string> t-l-rev: lang == 2 ? "Revision" : lang == 1 ? "晶片版本" : "芯片版本";
    property <string> t-l-mac: lang == 2 ? "MAC" : lang == 1 ? "MAC 位址" : "MAC 地址";
    property <string> t-l-flash: lang == 2 ? "Flash" : "Flash 容量";
    property <string> t-l-xtal: lang == 2 ? "Crystal" : lang == 1 ? "晶振頻率" : "晶振频率";
    property <string> t-l-features: lang == 2 ? "Features" : lang == 1 ? "晶片特性" : "芯片特性";
    property <string> t-l-bridge: lang == 2 ? "USB Bridge" : "USB 桥接";
    property <string> t-l-last: lang == 2 ? "Last Check" : lang == 1 ? "上次檢測" : "上次检测";

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // ---------- Header ----------
        HorizontalLayout {
            spacing: 12px;
            cross-axis-alignment: center;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "ESP32 Board Checker";
                    color: Palette.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: root.t-subtitle;
                    color: Palette.text-muted;
                    font-size: 12px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            ComboBox {
                width: 132px;
                model: ["简体中文", "繁体中文", "English"];
                current-index <=> root.lang;
                selected => { root.apply-language(); }
            }
        }

        // ---------- Body ----------
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 18px;

            // ===== Left: serial port list =====
            Card {
                width: 350px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: root.t-ports-title;
                            color: Palette.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        ActionButton {
                            label: root.t-refresh;
                            button-width: root.lang == 2 ? 84px : 68px;
                            active: !root.busy;
                            clicked => { root.refresh-ports(); }
                        }
                    }

                    if root.ports.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        background: Palette.inset;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Palette.inset-border;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: root.t-empty-title;
                                color: Palette.text-muted;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.t-empty-hint;
                                color: Palette.text-dim;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    if root.ports.length > 0 : ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 8px;

                            for entry[idx] in root.ports : PortListItem {
                                name: entry.name;
                                description: entry.description;
                                selected: idx == root.selected-index;
                                active: !root.busy;
                                clicked => { root.select-port(idx); }
                            }
                        }
                    }

                    Text {
                        text: root.t-list-hint;
                        color: Palette.text-dim;
                        font-size: 11px;
                    }
                }
            }

            // ===== Right: detection =====
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;

                Card {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;

                            ActionButton {
                                label: root.t-detect-button;
                                primary: true;
                                button-width: 140px;
                                active: !root.busy && root.ports.length > 0;
                                clicked => { root.detect(); }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: root.selected-port-name;
                                    color: Palette.text-secondary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.status-text;
                                    color: Palette.text-muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                Card {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: root.t-info-title;
                            color: Palette.text;
                            font-size: 15px;
                            font-weight: 600;
                        }

                        InfoRow { label: root.t-l-chip; value: root.chip-text; }
                        InfoRow { label: root.t-l-rev; value: root.revision-text; }
                        InfoRow { label: root.t-l-mac; value: root.mac-text; }
                        InfoRow { label: root.t-l-flash; value: root.flash-text; }
                        InfoRow { label: root.t-l-xtal; value: root.crystal-text; }
                        InfoRow { label: root.t-l-features; value: root.features-text; }
                        InfoRow { label: root.t-l-bridge; value: root.usb-bridge-text; }
                        InfoRow { label: root.t-l-last; value: root.last-check-text; }

                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // ===== Verdict =====
                VerdictCard {
                    kind: root.verdict-kind;
                    verdict-title: root.verdict-title;
                    verdict-reason: root.verdict-reason;
                }
            }
        }
    }
}
